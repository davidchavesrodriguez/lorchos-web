---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import MatchPreview from "../components/MatchPreview.astro";
import { nextMatch } from "../data/nextMatch";
import { trainingInfo } from "../data/training";
import aboutPhoto from "../assets/photos/TorneoFutbolGaelico-76.jpg";
import heroPhoto from "../assets/photos/TorneoFutbolGaelico-15.jpg";
// TODO: Replace with the final training-specific photograph when available.
import trainingPlaceholderPhoto from "../assets/photos/abride os ollos.jpg";
// TODO: Replace with the final GB Lorchos team-specific photograph.
import lorchosPlaceholderPhoto from "../assets/photos/Imagen de WhatsApp 2025-10-16 a las 21.05.59_d3814387.jpg";
// TODO: Replace with the final GB Lorchas team-specific photograph.
import lorchasPlaceholderPhoto from "../assets/photos/Imagen de WhatsApp 2025-11-06 a las 22.11.36_363464e3.jpg";
---

<BaseLayout
  title="GB Lorchos | Fútbol gaélico en Barbanza"
  description="GB Lorchos e GB Lorchas somos un club de fútbol gaélico aberto a quen queira coñecer, competir e formar parte dunha comunidade que segue medrando."
>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner container">
        <div class="hero__content">
          <p class="hero__eyebrow">Fútbol gaélico · Barbanza</p>
          <h1 id="hero-title">Fútbol gaélico feito en Barbanza.</h1>
          <p class="hero__intro">
            GB Lorchos e GB Lorchas somos un club de fútbol gaélico aberto a quen queira coñecer,
            competir e formar parte dunha comunidade que segue medrando.
          </p>
          <div class="hero__actions">
            <a class="hero__action hero__action--primary" href="/o-club/">Coñece o club</a>
            <a class="hero__action hero__action--secondary" href="/proba/">Ven probar</a>
          </div>
        </div>

        <figure class="hero__media">
          <Image
            class="hero__image"
            src={heroPhoto}
            alt="Xogador de GB Lorchos golpeando o balón durante un partido de fútbol gaélico"
            width={1440}
            widths={[480, 768, 1024, 1440]}
            sizes="(min-width: 56rem) 56vw, 100vw"
            loading="eager"
          />
        </figure>
      </div>
    </section>

    <section class="about" aria-labelledby="about-title">
      <div class="about__inner container">
        <div class="about__content">
          <p class="about__eyebrow">O CLUB</p>
          <h2 id="about-title">Un club para xogar, competir e facer comunidade.</h2>
          <p class="about__body">
            GB Lorchos e GB Lorchas somos un club de fútbol gaélico de Barbanza, con equipos
            masculino e feminino. Queremos competir, facer medrar este deporte en Galicia e manter
            un espazo aberto para quen queira achegarse e formar parte do club.
          </p>
          <a class="about__link" href="/o-club/">Coñece a nosa historia</a>
        </div>

        <figure class="about__media">
          <Image
            class="about__image"
            src={aboutPhoto}
            alt="Dous xogadores disputando unha xogada durante un partido de fútbol gaélico"
            width={1200}
            widths={[480, 768, 1200]}
            sizes="(min-width: 75rem) 42rem, (min-width: 60rem) 58vw, calc(100vw - 2rem)"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <section class="teams" aria-labelledby="teams-title">
      <div class="teams__inner container">
        <header class="teams__header">
          <div>
            <p class="teams__eyebrow">EQUIPOS</p>
            <h2 id="teams-title">Dous equipos. Un mesmo club.</h2>
          </div>
          <p class="teams__intro">
            Lorchos e Lorchas compartimos club, identidade e ganas de seguir facendo medrar o
            fútbol gaélico en Barbanza.
          </p>
        </header>

        <div class="teams__list">
          <article class="team">
            <div class="team__content">
              <h3>GB Lorchos</h3>
              <p>O equipo masculino do club.</p>
            </div>
            <figure class="team__media">
              <Image
                class="team__image"
                src={lorchosPlaceholderPhoto}
                alt="Fotografía do club"
                width={960}
                widths={[480, 720, 960]}
                sizes="(min-width: 75rem) 35rem, (min-width: 48rem) calc((100vw - 6rem) / 2), calc(100vw - 2rem)"
                loading="lazy"
              />
            </figure>
          </article>

          <article class="team">
            <div class="team__content">
              <h3>GB Lorchas</h3>
              <p>O equipo feminino do club.</p>
            </div>
            <figure class="team__media">
              <Image
                class="team__image"
                src={lorchasPlaceholderPhoto}
                alt="Fotografía do club"
                width={960}
                widths={[480, 720, 960]}
                sizes="(min-width: 75rem) 35rem, (min-width: 48rem) calc((100vw - 6rem) / 2), calc(100vw - 2rem)"
                loading="lazy"
              />
            </figure>
          </article>
        </div>

        <a class="teams__link" href="/equipos/">Coñece os equipos</a>
      </div>
    </section>

    <section class="next-match" aria-labelledby="next-match-title">
      <div class="next-match__inner container">
        <header class="next-match__header">
          <p class="next-match__eyebrow">PRÓXIMO PARTIDO</p>
          <h2 id="next-match-title">O seguinte encontro</h2>
        </header>

        <MatchPreview match={nextMatch} />

        <a class="next-match__link" href="/calendario/">Ver calendario completo</a>
      </div>
    </section>

    <section class="training" aria-labelledby="training-title">
      <div class="training__inner container">
        <div class="training__content">
          <p class="training__eyebrow">ADESTRAMENTOS</p>
          <h2 id="training-title">Queres probar o fútbol gaélico?</h2>
          <p class="training__body">
            Se queres coñecer o deporte e o club, escríbenos e ven a un adestramento. Axudámosche a
            empezar e explicámosche o necesario para participar.
          </p>

          <div class="training__practical">
            <dl class="training__details">
              <div>
                <dt>HORARIO</dt>
                <dd>{trainingInfo.schedule ?? "Por confirmar"}</dd>
              </div>
              {
                trainingInfo.venue && (
                  <div>
                    <dt>Lugar</dt>
                    <dd>{trainingInfo.venue}</dd>
                  </div>
                )
              }
              {
                trainingInfo.address && (
                  <div>
                    <dt>Enderezo</dt>
                    <dd>{trainingInfo.address}</dd>
                  </div>
                )
              }
            </dl>

            <a
              class="training__location"
              href={trainingInfo.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Abrir localización
            </a>
          </div>

          <a class="training__cta" href="/proba/">Ven probar</a>
        </div>

        <figure class="training__media">
          <Image
            class="training__image"
            src={trainingPlaceholderPhoto}
            alt="Fotografía do club"
            width={1200}
            widths={[480, 768, 1200]}
            sizes="(min-width: 75rem) 42rem, (min-width: 60rem) 58vw, calc(100vw - 2rem)"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <section class="sport-intro" aria-labelledby="sport-intro-title">
      <div class="sport-intro__inner container">
        <header class="sport-intro__header">
          <p class="sport-intro__eyebrow">FÚTBOL GAÉLICO</p>
          <h2 id="sport-intro-title">Un deporte diferente. Fácil de empezar a entender.</h2>
        </header>

        <div class="sport-intro__content">
          <p class="sport-intro__body">
            O fútbol gaélico combina xogo co pé e coa man nun deporte rápido, colectivo e dinámico.
            O obxectivo é avanzar co balón e puntuar entre os paus ou na portería rival.
          </p>
          <p class="sport-intro__support">Non necesitas coñecer as regras para vir probar.</p>
          <a class="sport-intro__link" href="/futbol-gaelico/">Descubre como se xoga</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    overflow: hidden;
    background: var(--color-brand-dark-blue);
    color: var(--color-brand-white);
  }

  .hero__inner {
    display: grid;
  }

  .hero__content {
    padding-block: clamp(var(--space-12), 12vw, var(--space-16));
  }

  .hero__eyebrow {
    margin-block-end: var(--space-4);
    padding-inline-start: var(--space-3);
    border-inline-start: 0.25rem solid var(--color-brand-cyan);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 11ch;
    margin-block-end: var(--space-6);
    font-size: clamp(3rem, 11vw, 5.25rem);
  }

  .hero__intro {
    max-width: 38rem;
    margin-block-end: var(--space-8);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
  }

  .hero__action {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border: 0.125rem solid transparent;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
  }

  .hero__action--primary {
    background: var(--color-brand-orange);
    color: var(--color-brand-dark-blue);
  }

  .hero__action--secondary {
    border-color: var(--color-brand-white);
    color: var(--color-brand-white);
  }

  .hero__action--primary:hover {
    background: var(--color-brand-white);
    color: var(--color-brand-dark-blue);
  }

  .hero__action--secondary:hover {
    border-color: var(--color-brand-cyan);
    color: var(--color-brand-white);
  }

  .hero__media {
    width: calc(100% + (2 * var(--page-gutter)));
    aspect-ratio: 4 / 3;
    margin: 0 calc(var(--page-gutter) * -1);
    overflow: hidden;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 42% center;
  }

  .about {
    background: var(--color-background-subtle);
  }

  .about__inner {
    display: grid;
    gap: var(--space-12);
    padding-block: clamp(var(--space-12), 10vw, var(--space-24));
  }

  .about__content {
    max-width: 38rem;
  }

  .about__eyebrow {
    margin-block-end: var(--space-4);
    padding-inline-start: var(--space-3);
    border-inline-start: 0.25rem solid var(--color-brand-cyan);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .about h2 {
    max-width: 14ch;
    margin-block-end: var(--space-6);
  }

  .about__body {
    margin-block-end: var(--space-6);
    line-height: 1.75;
  }

  .about__link {
    display: inline-block;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration-color: var(--color-brand-orange);
  }

  .about__link:hover {
    text-decoration-color: var(--color-brand-cyan);
  }

  .about__media {
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: hidden;
  }

  .about__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% center;
  }

  .teams {
    background: var(--color-brand-dark-blue);
    color: var(--color-brand-white);
  }

  .teams__inner {
    padding-block: clamp(var(--space-16), 10vw, var(--space-24));
  }

  .teams__header {
    display: grid;
    gap: var(--space-6);
    margin-block-end: clamp(var(--space-12), 7vw, var(--space-16));
  }

  .teams__eyebrow {
    margin-block-end: var(--space-4);
    padding-inline-start: var(--space-3);
    border-inline-start: 0.25rem solid var(--color-brand-cyan);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
  }

  .teams h2 {
    max-width: 12ch;
    margin-block-end: 0;
    color: var(--color-brand-white);
  }

  .teams__intro {
    margin-block-end: 0;
    color: var(--color-brand-white);
    line-height: 1.75;
  }

  .teams__list {
    display: grid;
    gap: var(--space-16);
  }

  .team__media {
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: hidden;
  }

  .team__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .team__content {
    padding-block-end: var(--space-6);
  }

  .team h3 {
    margin-block-end: var(--space-2);
    color: var(--color-brand-white);
    font-family: var(--font-editorial);
    font-size: clamp(2.75rem, 2.2rem + 2.75vw, 4.5rem);
    font-weight: 600;
  }

  .team p {
    margin-block-end: 0;
    color: var(--color-brand-white);
    font-size: 0.9375rem;
  }

  .teams__link {
    display: inline-block;
    margin-block-start: var(--space-12);
    color: var(--color-brand-white);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration-color: var(--color-brand-orange);
  }

  .teams__link:hover {
    color: var(--color-brand-white);
    text-decoration-color: var(--color-brand-cyan);
  }

  .next-match {
    background: var(--color-brand-white);
  }

  .next-match__inner {
    padding-block: clamp(var(--space-16), 10vw, var(--space-24));
  }

  .next-match__header {
    margin-block-end: var(--space-8);
  }

  .next-match__eyebrow {
    margin-block-end: var(--space-4);
    padding-inline-start: var(--space-3);
    border-inline-start: 0.25rem solid var(--color-brand-cyan);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
  }

  .next-match h2 {
    margin-block-end: 0;
  }

  .next-match__link {
    display: inline-block;
    margin-block-start: var(--space-12);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration-color: var(--color-brand-orange);
  }

  .next-match__link:hover {
    text-decoration-color: var(--color-brand-cyan);
  }

  .training {
    background: var(--color-background-subtle);
  }

  .training__inner {
    display: grid;
    gap: var(--space-12);
    padding-block: clamp(var(--space-16), 10vw, var(--space-24));
  }

  .training__content {
    max-width: 38rem;
  }

  .training__eyebrow {
    margin-block-end: var(--space-4);
    padding-inline-start: var(--space-3);
    border-inline-start: 0.25rem solid var(--color-brand-cyan);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
  }

  .training h2 {
    max-width: 13ch;
    margin-block-end: var(--space-6);
  }

  .training__body {
    margin-block-end: var(--space-8);
    line-height: 1.75;
  }

  .training__practical {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
    padding-block: var(--space-6);
    border-block: 1px solid var(--color-border);
  }

  .training__details {
    display: grid;
    width: 100%;
    gap: var(--space-4);
    justify-items: start;
    margin: 0;
  }

  .training__details div {
    display: grid;
    justify-items: start;
  }

  .training__details dt {
    margin-block-end: var(--space-1);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .training__details dd {
    margin: 0;
    padding: 0;
    font-size: 1rem;
    font-weight: 600;
    text-align: start;
  }

  .training__location {
    justify-self: start;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
    text-decoration-color: var(--color-brand-orange);
  }

  .training__location:hover {
    text-decoration-color: var(--color-brand-cyan);
  }

  .training__cta {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    margin-block-start: var(--space-8);
    padding: var(--space-3) var(--space-6);
    border: 0.125rem solid var(--color-brand-orange);
    background: var(--color-brand-orange);
    color: var(--color-brand-dark-blue);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
  }

  .training__cta:hover {
    background: var(--color-brand-dark-blue);
    color: var(--color-brand-white);
  }

  .training__media {
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: hidden;
  }

  .training__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .sport-intro {
    background: var(--color-brand-white);
  }

  .sport-intro__inner {
    display: grid;
    gap: var(--space-8);
    padding-block: clamp(var(--space-12), 7vw, var(--space-16));
    border-block-start: 0.125rem solid var(--color-brand-cyan);
  }

  .sport-intro__eyebrow {
    margin-block-end: var(--space-4);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
  }

  .sport-intro h2 {
    max-width: 14ch;
    margin-block-end: 0;
  }

  .sport-intro__body {
    margin-block-end: var(--space-6);
    line-height: 1.75;
  }

  .sport-intro__support {
    margin-block-end: var(--space-6);
    font-weight: 600;
  }

  .sport-intro__link {
    display: inline-block;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration-color: var(--color-brand-orange);
  }

  .sport-intro__link:hover {
    text-decoration-color: var(--color-brand-cyan);
  }

  @media (min-width: 28rem) {
    .hero__actions {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 56rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      min-height: 40rem;
    }

    .hero__content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-block: var(--space-16);
      padding-inline-end: clamp(var(--space-8), 5vw, var(--space-16));
    }

    .hero h1 {
      font-size: clamp(3.75rem, 6.5vw, 5.25rem);
    }

    .hero__media {
      width: auto;
      min-height: 100%;
      margin: 0;
      aspect-ratio: auto;
    }
  }

  @media (min-width: 60rem) {
    .about__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: clamp(var(--space-8), 6vw, var(--space-16));
    }

    .about__content {
      grid-column: 2;
      grid-row: 1;
    }

    .about__media {
      grid-column: 1;
      grid-row: 1;
    }

    .training__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: stretch;
      gap: clamp(var(--space-8), 6vw, var(--space-16));
    }

    .training__content {
      align-self: center;
    }

    .training__media {
      min-height: 34rem;
      aspect-ratio: auto;
    }
  }

  @media (min-width: 48rem) {
    .teams__header {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: end;
      gap: var(--space-12);
    }

    .teams__intro {
      padding-block-end: var(--space-1);
    }

    .teams__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(var(--space-6), 4vw, var(--space-8));
    }

    .teams__link {
      margin-block-start: var(--space-16);
    }
  }

  @media (min-width: 56rem) {
    .sport-intro__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: start;
      gap: clamp(var(--space-8), 7vw, var(--space-16));
    }

    .sport-intro__content {
      padding-block-start: calc(var(--space-6) + var(--space-1));
    }
  }
</style>
